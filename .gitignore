# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/

# ── Virtual envs ─────────────────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter checkpoints ──────────────────────────────────────────
.ipynb_checkpoints/

# ── Large computed artefacts (too big for GitHub, regenerable) ───
data/processed/
results/models/*.pkl
results/models/*.npy
